#!/usr/bin/env bash

# Enable nullglob to prevent the loop from running if no image files exist
shopt -s nullglob

v_pos=""
h_pos=""

# Parse command line arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --n) v_pos="North" ;;
        --s) v_pos="South" ;;
        --w) h_pos="West" ;;
        --e) h_pos="East" ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
    shift
done

# Construct the gravity string based on flags
gravity="${v_pos}${h_pos}"

# If no flags were provided, default to Center
if [[ -z "$gravity" ]]; then
    gravity="Center"
fi

echo "Setting alignment to: $gravity"

# Ensure the output folder exists
output_folder="resized"
mkdir -p "$output_folder"

# Prompt the user for resolution
read -p "Resolution: " resolution

# Check if the user provided a valid resolution
if ! [[ $resolution =~ ^[0-9]+x[0-9]+$ ]]; then
  echo "Invalid resolution format. Please run the script again and provide a valid resolution."
  exit 1
fi

# Resize images
count=0
for file in *.jpg *.jpeg *.png *.webp; do
  if [[ -f "$file" ]]; then
    output_file="$output_folder/${file%.*}_resized.jpg"

    echo "Processing: $file..."

    magick "$file" -resize "$resolution^" -gravity "$gravity" -extent "$resolution" "$output_file" 2>/dev/null
    
    ((count++))
  fi
done

echo "Done! Processed $count images into '$output_folder/'."